+import PocketBase from 'pocketbase'
+import { fetchConLog } from './httpLog'
+import { createLogger } from './logger'
+
+const log = createLogger('pocketbase')
+
+/**
+ * Cliente singleton de PocketBase compartido por toda la app.
+ *
+ * La URL del servidor se lee de la variable de entorno VITE_PB_URL
+ * (definida en .env.local, que no se sube a git). Ejemplo:
+ *   VITE_PB_URL=https://pb.tudominio.com
+ *
+ * Los permisos (quién puede listar, crear, editar o borrar) se controlan
+ * con las "API Rules" de la colección en el panel de PocketBase.
+ *
+ * No se importa directamente desde los componentes: todo el acceso a datos
+ * pasa por lib/presupuestosRepo.js.
+ */
+const url = import.meta.env.VITE_PB_URL
+
+if (!url) {
+  log.error('Falta VITE_PB_URL en .env.local: la app no podrá conectar con PocketBase.')
+}
+
+export const pb = new PocketBase(url)
+
+// Por defecto el SDK cancela peticiones duplicadas en curso. En desarrollo,
+// React StrictMode monta los efectos dos veces y eso provocaría errores
+// "autocancelled" al cargar el historial. Se desactiva para evitarlo.
+pb.autoCancellation(false)
+
+// Todas las peticiones pasan por el fetch instrumentado (registro HTTP)
+pb.beforeSend = (reqUrl, options) => {
+  options.fetch = fetchConLog
+  return { url: reqUrl, options }
+}
+
+/**
+ * PocketBase devuelve las fechas como "2026-09-25 10:00:00.000Z" (con espacio).
+ * Safari/iOS no siempre sabe interpretarlas con new Date(), así que se
+ * normalizan a ISO ("...T...").
+ */
+export function pbDateToIso(value) {
+  if (!value) return value
+  return String(value).replace(' ', 'T')
+}
